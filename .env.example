# SQLite database path (relative paths start at the project root)
DATABASE_PATH=instance/dashboard.db

# World Bank Indicators API
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2
WORLD_BANK_COUNTRIES=JPN,KOR,CHN,IND,IDN,AUS,USA,CAN,MEX,BRA,GBR,FRA,DEU,ZAF,NGA
DATA_START_YEAR=2000
# Empty means the current year
DATA_END_YEAR=

# Responsible API access
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=3
REQUEST_BACKOFF_FACTOR=0.8
REQUEST_INTERVAL_SECONDS=0.5
USER_AGENT=OpenDataDashboard/1.0 (learning project; contact: set-your-email@example.com)

# Flask local server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
