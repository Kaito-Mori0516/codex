# Copy this file to infrastructure/deploy.env and fill only the values you use.
# deploy.env is ignored by Git.

# AWS CLI / IAM Identity Center profile
AWS_PROFILE=world-data-lens
AWS_REGION=ap-northeast-1

# Required before public production use
WDL_OPERATOR_NAME=
WDL_CONTACT_EMAIL=

# Optional monitoring (recommended)
WDL_ALARM_EMAIL=
WDL_BUDGET_EMAIL=

# Optional external payment link. Never put card data or a Stripe secret key here.
WDL_BUSINESS_PRICE_LABEL=
WDL_BUSINESS_CHECKOUT_URL=
WDL_ENTERPRISE_CONTACT_URL=

# Optional first-party sponsor banner (lowest privacy impact)
WDL_SPONSOR_TEXT=
WDL_SPONSOR_URL=

# Optional Google AdSense public identifiers. Enable only after privacy/CMP review.
WDL_ADSENSE_CLIENT_ID=
WDL_ADSENSE_SLOT_ID=
